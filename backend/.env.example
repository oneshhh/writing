PORT=3000
NODE_ENV=development

# Public app URL. Used for setup defaults and deployment guidance.
APP_URL=http://localhost:3000

# Optional. If omitted, the app can generate this during first-time setup.
CORS_ORIGINS=http://localhost:3000

# Supabase project configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_JWT_AUD=authenticated

# PostgreSQL connection used to bootstrap the schema automatically.
# Use either DATABASE_URL or the DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME fields below.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=postgres
# DB_SSL=false

# Optional AI integration. If omitted, the AI detector falls back gracefully.
HUGGINGFACE_API_TOKEN=
AI_DETECTOR_MODEL=noumenon-labs/Earlybird-fast

# Optional first-run admin bootstrap through environment variables.
# If these are present and no admin exists yet, the server creates the admin on startup.
BOOTSTRAP_ADMIN_FULL_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional deploy stub token
DEPLOY_TOKEN=

# Optional payment proof upload controls
PAYMENT_PROOF_BUCKET=payment-proofs
PAYMENT_PROOF_UPLOADS_ENABLED=true
