{
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "excludeFiles": [
        "datasets/**",
        "models/**",
        "scripts/**",
        "public/**"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/",
      "destination": "/login.html"
    }
  ]
}
